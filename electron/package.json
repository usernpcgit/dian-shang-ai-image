{
  "name": "dianshang-ai-image",
  "version": "0.2.7",
  "description": "电商AI生图桌面端（Electron 轻壳，加载云端网页端，不捆绑 Python）",
  "main": "main.js",
  "author": "usernpcgit",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "build": {
    "appId": "com.usernpcgit.dianshangai",
    "productName": "电商AI生图",
    "icon": "build/icon.icns",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "update-check.js", "after-sign.js"],
    "afterSign": "after-sign.js",
    "mac": {
      "icon": "build/icon.icns",
      "target": ["dmg", "zip"],
      "category": "public.app-category.photography",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "publish": { "provider": "github", "owner": "usernpcgit", "repo": "dian-shang-ai-image" }
  },
  "devDependencies": {
    "electron": "^31.5.0",
    "electron-builder": "^24.13.3"
  }
}
